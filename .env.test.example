# Copy this file to `.env.test` and fill in your real MTN MoMo sandbox credentials.
# `.env.test` is gitignored and is used ONLY by the test suite (npm test).

# The callback URL for receiving payment notifications.
MOMO_CALLBACK_HOST=<your-callback-host>

# Your MTN Momo user API key (generated via `npx momo-sandbox`).
MOMO_USER_API_KEY=<your-user-api-key>

# Your MTN Momo user ID (generated via `npx momo-sandbox`).
MOMO_USER_ID=<your-user-id>

# Your MTN Momo primary key.
MOMO_PRIMARY_KEY=<your-primary-key>

# The MTN MoMo target environment. Tests only run against the sandbox.
MOMO_TARGET_ENVIRONMENT=sandbox

# A sandbox payer MSISDN to use as the `partyId` in request-to-pay tests.
MOMO_PARTY_ID=<sandbox-payer-msisdn>

# The amount (in the environment's default currency) to request in tests.
MOMO_AMOUNT=100
